//-----------------------------------------------------------------------------
// Module      : UART Transmitter Testbench
// File        : tb_uart_tx.v
// Author      : Harshita R M
// Description :
//   Testbench for UART Transmitter.
//   Generates system clock, baud tick, reset, and transmit request.
//   Verifies UART frame transmission through RTL simulation.
//-----------------------------------------------------------------------------

module uart_tx_tb;

    //--------------------------------------------------------------------------
    // Testbench Signals
    //--------------------------------------------------------------------------
    reg        clk;
    reg        rst;
    reg        tx_start;
    reg [7:0] tx_data;
    reg        baud_tick;

    wire tx;
    wire busy;

    //--------------------------------------------------------------------------
    // DUT Instantiation
    //--------------------------------------------------------------------------
    uart_tx uut (
        .clk(clk),
        .rst(rst),
        .tx_start(tx_start),
        .tx_data(tx_data),
        .baud_tick(baud_tick),
        .tx(tx),
        .busy(busy)
    );

    //--------------------------------------------------------------------------
    // Clock Generation (100 MHz)
    //--------------------------------------------------------------------------
    initial
        clk = 1'b0;

    always
        #5 clk = ~clk;

    //--------------------------------------------------------------------------
    // Test Sequence
    //--------------------------------------------------------------------------
    initial
    begin
        // Initialize signals
        rst      = 1'b1;
        tx_start = 1'b0;
        tx_data  = 8'd0;

        // Release reset
        #20;
        rst = 1'b0;

        // Apply transmit request
        #10;
        tx_data  = 8'b10110010;
        tx_start = 1'b1;

        // Keep tx_start asserted for one clock cycle
        #10;
        tx_start = 1'b0;

        // Wait for transmission to complete
        #1000;

        $finish;
    end

    //--------------------------------------------------------------------------
    // Baud Tick Generator
    //--------------------------------------------------------------------------
    initial
    begin
        baud_tick = 1'b0;

        forever
        begin
            repeat (5) @(posedge clk);

            baud_tick = 1'b1;

            @(posedge clk);

            baud_tick = 1'b0;
        end
    end

endmodule
